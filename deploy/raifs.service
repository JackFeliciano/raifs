[Unit]
Description=RAIFS financial reporting
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/raifs
Environment=RAIFS_BASE=/raifs/
ExecStart=/usr/bin/php -S 127.0.0.1:8120 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/raifs
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
